# Variables de entorno del Backend — XESSIA
# IMPORTANTE: Este archivo NUNCA debe subirse a GitHub

# MongoDB Atlas — reemplaza con tu cadena de conexión real
# Formato: mongodb+srv://<usuario>:<contraseña>@<cluster>.mongodb.net/<nombre-db>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USUARIO:CONTRASEÑA@cluster0.XXXXX.mongodb.net/xessia?retryWrites=true&w=majority

# Clave secreta para firmar los JWT (puedes usar cualquier texto largo y aleatorio)
JWT_SECRET=xessia_jwt_secret_catalina_eva_2024_muy_seguro

# Clave para el endpoint de semilla inicial (cambia esto antes de ejecutar)
SEED_SECRET=inicializar_xessia_2024

# Puerto del servidor (Railway/Render lo configura automáticamente)
PORT=3001
